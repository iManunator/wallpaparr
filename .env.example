# LAN URL the TV and other machines can open (not 127.0.0.1).
# docker compose interpolates this into the container as PUBLIC_BASE_URL.
PUBLIC_BASE_URL=http://192.168.1.10:8787

# Optional HTTP basic auth for the web UI and mutating APIs. Unset = open LAN
# (the historical default). Plugin wallpaper GETs stay unauthenticated either
# way so the TV still works. Do not commit a real password.
# WALLPAPARR_AUTH_USER=admin
# WALLPAPARR_AUTH_PASSWORD=change-me

# Optional container user. Default 0:0 (root) keeps existing ./data bind-mounts
# writable. To drop privileges: chown -R $PUID:$PGID data
# PUID=1000
# PGID=1000

# Optional in-container path overrides. Compose already sets these to /data/*.
# Only needed for a custom docker run, or if you split the gallery onto another disk
# (see docs/INSTALL.md). Do not point these at host paths — they are inside the container.
# SUITE_DATA=/data
# SUITE_CONFIG=/data/config.json
# SUITE_LAYOUTS=/data/layouts
# SUITE_GALLERY=/data/gallery
# SUITE_CATALOG=/data/catalog.json
